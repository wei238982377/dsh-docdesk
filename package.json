{
  "name": "dsh-docdesk",
  "version": "0.2.4",
  "description": "An add-only Markdown library for DeepSeek Harness: pick documents from workspaces, place icons on a fixed non-overlapping desktop grid, marquee-select and move groups, render GFM tables and Mermaid/chart code blocks, and read full-screen with browser-style tabs. · DSH 资料区：主动挑选 Markdown 文档，在固定网格桌面内对齐摆放，支持右键框选整组拖动、表格与 Mermaid/图表代码块渲染和标签页全屏阅读。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "docs/**/*",
    "vendor/**/*",
    "screenshots.json",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "markdown",
    "documents",
    "library",
    "desktop",
    "materials"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wei238982377/dsh-docdesk.git"
  },
  "bugs": {
    "url": "https://github.com/wei238982377/dsh-docdesk/issues"
  },
  "homepage": "https://github.com/wei238982377/dsh-docdesk#readme",
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.3"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
